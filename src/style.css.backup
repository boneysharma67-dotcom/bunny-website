:root {
  font-family: Inter, system-ui, sans-serif;
  color: #111;
  background: #f7f8f4;
  --accent: #b8ff3d;
  --dark: #111;
  --muted: #686868;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
}

body {
  background: #f7f8f4;
  color: var(--dark);
}

a {
  color: inherit;
  text-decoration: none;
}

.navbar {
  height: 78px;
  padding: 0 7%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-bottom: 1px solid #ddd;
  position: sticky;
  top: 0;
  z-index: 10;
}

.logo {
  font-size: 22px;
  font-weight: 900;
  letter-spacing: -1px;
}

nav {
  display: flex;
  gap: 30px;
}

nav a {
  font-size: 14px;
  font-weight: 600;
}

.nav-btn,
.btn.primary,
form button {
  background: var(--dark);
  color: white;
  padding: 13px 21px;
  border-radius: 30px;
  font-weight: 700;
  border: 0;
}

.hero {
  min-height: 650px;
  padding: 90px 7%;
  display: grid;
  grid-template-columns: 1.2fr .8fr;
  align-items: center;
  gap: 60px;
  background: #fff;
}

.eyebrow {
  font-size: 12px;
  font-weight: 900;
  letter-spacing: 2px;
  margin-bottom: 18px;
}

h1 {
  font-size: clamp(48px, 7vw, 92px);
  line-height: .94;
  letter-spacing: -5px;
  max-width: 850px;
}

h1 span {
  color: #777;
}

.hero-text {
  max-width: 560px;
  color: var(--muted);
  font-size: 18px;
  line-height: 1.6;
  margin: 28px 0;
}

.hero-buttons {
  display: flex;
  gap: 14px;
  flex-wrap: wrap;
}

.btn.secondary {
  padding: 13px 21px;
  border: 1px solid #ccc;
  border-radius: 30px;
  font-weight: 700;
}

.hero-card {
  background: var(--accent);
  border-radius: 40px;
  padding: 55px 35px;
  min-height: 380px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  text-align: center;
  transform: rotate(2deg);
}

.circle {
  font-size: 90px;
  margin-bottom: 20px;
}

.hero-card h3 {
  font-size: 28px;
  margin-bottom: 10px;
}

.hero-card p {
  color: #333;
}

.section {
  padding: 110px 7%;
}

.section h2 {
  font-size: clamp(38px, 5vw, 68px);
  line-height: 1;
  letter-spacing: -3px;
  max-width: 800px;
  margin-bottom: 55px;
}

.cards {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18px;
}

.card {
  background: white;
  padding: 30px;
  min-height: 260px;
  border: 1px solid #ddd;
  border-radius: 24px;
  transition: .25s;
}

.card:hover {
  transform: translateY(-8px);
}

.icon {
  font-size: 38px;
  margin-bottom: 40px;
}

.card h3 {
  font-size: 21px;
  margin-bottom: 10px;
}

.card p {
  color: var(--muted);
  line-height: 1.5;
}

.about {
  background: var(--dark);
  color: white;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 70px;
}

.about .eyebrow {
  color: var(--accent);
}

.features {
  display: grid;
  gap: 0;
}

.features div {
  display: flex;
  gap: 30px;
  padding: 25px 0;
  border-bottom: 1px solid #444;
}

.features strong {
  color: var(--accent);
}

.features span {
  font-size: 20px;
}

.contact {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 70px;
  background: var(--accent);
}

.contact h2 {
  margin-bottom: 20px;
}

.contact p {
  color: #333;
  line-height: 1.6;
}

form {
  display: grid;
  gap: 14px;
}

input,
textarea {
  width: 100%;
  padding: 17px;
  border: 1px solid #222;
  border-radius: 12px;
  background: white;
  font: inherit;
}

textarea {
  min-height: 130px;
  resize: vertical;
}

form button {
  cursor: pointer;
  padding: 16px;
  font-size: 15px;
}

footer {
  padding: 45px 7%;
  background: #111;
  color: white;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
}

footer p {
  color: #aaa;
}

@media (max-width: 850px) {
  nav {
    display: none;
  }

  .hero,
  .about,
  .contact {
    grid-template-columns: 1fr;
  }

  .cards {
    grid-template-columns: 1fr 1fr;
  }

  h1 {
    letter-spacing: -3px;
  }
}

@media (max-width: 550px) {
  .navbar {
    padding: 0 5%;
  }

  .hero,
  .section {
    padding: 70px 5%;
  }

  .cards {
    grid-template-columns: 1fr;
  }

  .nav-btn {
    padding: 10px 15px;
    font-size: 13px;
  }

  footer {
    flex-direction: column;
    align-items: flex-start;
  }
}
